import { ImageResponse } from "next/og"
import { rethrowIfFrameworkError } from "@/lib/next-control-flow"
import { ROLE_STYLES as SHARED_ROLE_STYLES } from "@/lib/roles"
import type { NextRequest } from "next/server"

const ROLE_STYLES = SHARED_ROLE_STYLES

type RoleType = keyof typeof ROLE_STYLES

const DEFAULT_ACCENT = "#6366f1" // indigo accent for profiles

const LUNAR_LOGO_URL = "https://files.catbox.moe/rl48xt.png"
const DEFAULT_AVATAR_URL = "https://files.catbox.moe/l9c4ta.jpg"

export async function GET(req: NextRequest) {
  try {
    const { searchParams } = new URL(req.url)

    // Example call:
    // /api/profile-embed?username=Vireon&cover=...&banner=...&role=VERIFIED|ADMIN&themecolor=6366f1
    const username = searchParams.get("username")
    if (!username) {
      return new Response("Missing username parameter", { status: 400 })
    }

    const avatarUrl = searchParams.get("cover") || DEFAULT_AVATAR_URL
    const bannerUrl = searchParams.get("banner")
    const roleParam = searchParams.get("role") || ""
    const themeParam = searchParams.get("themecolor")

    const accent = themeParam
      ? themeParam.startsWith("#")
        ? themeParam
        : `#${themeParam}`
      : DEFAULT_ACCENT

    const roles = roleParam
      .split("|")
      .map((r) => r.trim().toUpperCase())
      .filter((r) => r in ROLE_STYLES) as RoleType[]

    const isVerified = roles.includes("VERIFIED" as RoleType)

    return new ImageResponse(
      (
        <div
          style={{
            display: "flex",
            width: "1920px",
            height: "1080px",
            backgroundColor: "#050505",
            fontFamily: "system-ui, sans-serif",
            position: "relative",
            overflow: "hidden",
          }}
        >
          {/* Background banner layer */}
          {bannerUrl && (
            <img
              src={bannerUrl}
              style={{
                position: "absolute",
                top: 0,
                left: 0,
                width: "100%",
                height: "100%",
                objectFit: "cover",
                filter: "blur(10px)",
                opacity: 0.4,
              }}
            />
          )}
          <div
            style={{
              position: "absolute",
              top: 0,
              left: 0,
              right: 0,
              bottom: 0,
              background: `linear-gradient(135deg, rgba(5, 5, 5, 0.9), rgba(5, 5, 5, 0.7)), radial-gradient(circle at 20% 20%, ${accent}2e, transparent 55%)`,
            }}
          />

          {/* Glass content panel */}
          <div
            style={{
              display: "flex",
              flexDirection: "column",
              justifyContent: "center",
              gap: "40px",
              width: "820px",
              margin: "80px",
              padding: "64px",
              borderRadius: "32px",
              background: "rgba(10, 10, 10, 0.55)",
              border: "1px solid rgba(255, 255, 255, 0.08)",
              position: "relative",
            }}
          >
            {/* Avatar + name row */}
            <div style={{ display: "flex", alignItems: "center", gap: "36px" }}>
              <img
                src={avatarUrl}
                width="180"
                height="180"
                style={{
                  width: "180px",
                  height: "180px",
                  borderRadius: "36px",
                  objectFit: "cover",
                  border: `3px solid ${accent}`,
                }}
              />
              <div style={{ display: "flex", flexDirection: "column", gap: "8px" }}>
                <div style={{ display: "flex", alignItems: "center", gap: "16px" }}>
                  <div
                    style={{
                      display: "flex",
                      fontSize: "64px",
                      fontWeight: 800,
                      color: "#ffffff",
                      letterSpacing: "-0.02em",
                    }}
                  >
                    {username}
                  </div>
                  {isVerified && (
                    <svg
                      style={{ display: "flex", width: "40px", height: "40px" }}
                      viewBox="0 0 24 24"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
                        fill="#1D9BF0"
                      />
                      <path
                        d="M17.5 8.5L10.5 15.5L6.5 11.5"
                        stroke="white"
                        strokeWidth="2"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />
                    </svg>
                  )}
                </div>
                <div style={{ display: "flex", fontSize: "32px", color: "rgba(255, 255, 255, 0.55)" }}>
                  @{username}
                </div>
              </div>
            </div>

            {/* Divider */}
            <div style={{ display: "flex", width: "100%", height: "1px", background: "rgba(255, 255, 255, 0.1)" }} />

            {/* Role badges */}
            {roles.length > 0 && (
              <div style={{ display: "flex", flexWrap: "wrap", gap: "16px" }}>
                {roles.map((roleType, index) => {
                  if (roleType === ("VERIFIED" as RoleType)) return null

                  const style = ROLE_STYLES[roleType]
                  if (!style) return null

                  return (
                    <div
                      key={index}
                      style={{
                        display: "flex",
                        alignItems: "center",
                        justifyContent: "center",
                        padding: "12px 26px",
                        borderRadius: "12px",
                        fontSize: "26px",
                        fontWeight: 700,
                        background: "rgba(10, 10, 10, 0.6)",
                        border: `2px solid ${style.border}`,
                        color: style.text,
                      }}
                    >
                      {roleType}
                    </div>
                  )
                })}
              </div>
            )}
          </div>

          {/* Footer: logo + wordmark, bottom-left of canvas */}
          <div
            style={{
              display: "flex",
              alignItems: "center",
              gap: "20px",
              position: "absolute",
              bottom: "64px",
              left: "96px",
            }}
          >
            <img
              src={LUNAR_LOGO_URL}
              style={{
                width: "56px",
                height: "56px",
                borderRadius: "50%",
                objectFit: "cover",
                border: `2px solid ${accent}`,
              }}
            />
            <div style={{ display: "flex", flexDirection: "column" }}>
              <div style={{ display: "flex", fontSize: "32px", fontWeight: 700, color: "#ffffff" }}>
                Lunar
              </div>
              <div style={{ display: "flex", fontSize: "22px", color: "rgba(255, 255, 255, 0.5)" }}>
                lunarx.to
              </div>
            </div>
          </div>
        </div>
      ),
      {
        width: 1920,
        height: 1080,
      }
    )
  } catch (error) {
    rethrowIfFrameworkError(error)
    console.error(error)
    return new Response("Failed to generate image", { status: 500 })
  }
}
